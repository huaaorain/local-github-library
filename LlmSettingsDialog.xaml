<Window x:Class="GitHubTopicReports.LlmSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LLM 设置"
        Width="820"
        Height="720"
        MinWidth="720"
        MinHeight="620"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI Variable Text"
        FontSize="14"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontFamily="Segoe UI Variable Display"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Text="LLM 设置" />
                <TextBlock Margin="0,4,0,0"
                           Text="模型包与生成提示词分别管理，互不覆盖。"
                           Style="{StaticResource QuietTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                <Button x:Name="SavePromptButton"
                        Width="92"
                        Padding="10,7"
                        Content="保存"
                        Visibility="Collapsed"
                        Click="SavePromptButton_Click" />
                <Button x:Name="EditPromptButton"
                        Width="104"
                        Padding="10,7"
                        Content="修改提示词"
                        Click="EditPromptButton_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Padding="16,14"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="LLM 模型包"
                               Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="CurrentModelNameText"
                               Margin="0,7,0,0"
                               FontWeight="SemiBold"
                               Text="尚未导入模型包" />
                    <TextBlock x:Name="CurrentModelDetailsText"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource QuietTextStyle}" />
                    <TextBlock x:Name="ModelStatusText"
                               Margin="0,6,0,0"
                               Foreground="#B45309"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="ImportLlmPackageButton"
                        Grid.Column="1"
                        MinWidth="118"
                        Margin="18,0,0,0"
                        Padding="12,8"
                        VerticalAlignment="Top"
                        Content="导入 LLM 包"
                        Click="ImportLlmPackageButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="16,14"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="LLM 提示词"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="PromptSourceText"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource QuietTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Top"
                                Orientation="Horizontal">
                        <Button x:Name="ImportPromptButton"
                                Padding="10,7"
                                Content="导入提示词"
                                Click="ImportPromptButton_Click" />
                        <Button x:Name="ExportPromptButton"
                                Margin="8,0,0,0"
                                Padding="10,7"
                                Content="导出提示词"
                                Click="ExportPromptButton_Click" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1"
                           Margin="0,10,0,7"
                           Text="提示词默认只读。请点击右上角“修改提示词”。"
                           Style="{StaticResource QuietTextStyle}" />

                <TextBox x:Name="PromptTextBox"
                         Grid.Row="2"
                         Padding="12,10"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="Consolas"
                         FontSize="13"
                         HorizontalScrollBarVisibility="Disabled"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         SpellCheck.IsEnabled="False"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Grid.Row="3"
                           Margin="0,8,0,0"
                           Text="可用占位符：{{FullName}}、{{Description}}、{{Topics}}、{{ReadmeSummary}}。其中 {{FullName}} 必须保留。"
                           TextWrapping="Wrap"
                           Style="{StaticResource QuietTextStyle}" />
                <TextBlock x:Name="PromptStatusText"
                           Grid.Row="4"
                           Margin="0,5,0,0"
                           Foreground="#B45309"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="DialogGlobalStatusText"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Style="{StaticResource QuietTextStyle}" />
            <Button Width="92"
                    HorizontalAlignment="Right"
                    Padding="10,7"
                    Content="关闭"
                    IsCancel="True"
                    Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
