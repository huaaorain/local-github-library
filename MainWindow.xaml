            <TabItem x:Name="NotesTab" Header="笔记">
                <Grid Margin="0"
                      TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="NotesLeftColumn"
