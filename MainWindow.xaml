                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource QuietTextStyle}"
                                               Text="0 份" />
                                </Grid>
                                <ListBox x:Name="HistoryList"
                                         Grid.Row="1"
                                         Margin="6,0"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="HistoryList_SelectionChanged"
                                         MouseDoubleClick="HistoryList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,7">
                                                <TextBlock Text="{Binding Keyword}"
                                                           FontWeight="SemiBold"
                                                           ToolTip="{Binding Keyword}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding DisplayTimestamp}"
                                                           Style="{StaticResource QuietTextStyle}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="1"
                                           Text="暂无查询记录。&#10;输入主题并点击“开始查找”。">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource EmptyStateTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=HistoryList}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button x:Name="OpenSelectedReportButton"
                                        Grid.Row="2"
                                        Margin="12"
                                        Padding="10,7"
                                        Content="打开所选报告"
                                        IsEnabled="False"
                                        Click="OpenSelectedReportButton_Click" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="CurrentKeywordText"
                                               Text="尚未查询"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="ResultSummaryText"
                                               Margin="0,3,0,0"
                                               Text="输入英文主题通常能获得更完整的 GitHub 搜索结果。"
                                               Style="{StaticResource QuietTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="显示数量" />
                                        <ComboBox x:Name="ResultCountComboBox"
                                                  Width="92"
                                                  Height="36"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  Padding="8,0"
                                                  IsEditable="True"
                                                  ToolTip="可选择 10、20、50、100，也可以直接输入 1-1000" />
                                    </StackPanel>
                                    <TextBlock x:Name="LastGeneratedText"
                                               Margin="0,4,0,0"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource QuietTextStyle}" />
                                </StackPanel>
                            </Grid>
                            <TabControl Grid.Row="1"
                                        BorderThickness="1">
                                <TabItem Header="当前 Star 排行">
                                    <DataGrid x:Name="CurrentGrid"
                                              AutoGenerateColumns="False"
                                              BorderThickness="1"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserReorderColumns="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              SelectionMode="Single"
                                              SelectionChanged="RepositoryGrid_SelectionChanged"
                                              Sorting="SearchResultsGrid_Sorting"
                                              MouseDoubleClick="RepositoryGrid_MouseDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#"
                                                                Binding="{Binding Rank}"
                                                                SortMemberPath="Rank"
                                                                ElementStyle="{StaticResource GridNumericTextStyle}"
                                                                Width="42" />
                                            <DataGridTextColumn Header="仓库"
                                                                Binding="{Binding FullName}"
                                                                SortMemberPath="FullName"
                                                                ElementStyle="{StaticResource GridTextEllipsisStyle}"
                                                                MinWidth="140"
                                                                Width="*" />
                                            <DataGridTextColumn Header="Star"
                                                                Binding="{Binding StarsDisplay}"
                                                                SortMemberPath="Stars"
                                                                ElementStyle="{StaticResource GridNumericTextStyle}"
                                                                Width="92" />
                                            <DataGridTextColumn Header="语言"
                                                                Binding="{Binding Language}"
                                                                ElementStyle="{StaticResource GridTextEllipsisStyle}"
                                                                Width="95" />
                                            <DataGridTextColumn Header="更新"
                                                                Binding="{Binding UpdatedDisplay}"
                                                                ElementStyle="{StaticResource GridTextEllipsisStyle}"
                                                                Width="95" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="本地周增长排行">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Padding="10"
                                                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                                BorderThickness="1,1,1,0">
                                            <TextBlock x:Name="GrowthNoticeText"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource QuietTextStyle}"
                                                       Text="周增长使用同一关键词至少 7 天前的本机报告作为基线；首次查询需要先积累历史。" />
                                        </Border>
                                        <DataGrid x:Name="GrowthGrid"
                                                  Grid.Row="1"
                                                  AutoGenerateColumns="False"
                                                  BorderThickness="1"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserReorderColumns="False"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  SelectionMode="Single"
                                                  SelectionChanged="RepositoryGrid_SelectionChanged"
                                                  MouseDoubleClick="RepositoryGrid_MouseDoubleClick">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#"
                                                                    Binding="{Binding Rank}"
                                                                    ElementStyle="{StaticResource GridNumericTextStyle}"
                                                                    Width="42" />
                                                <DataGridTextColumn Header="仓库"
                                                                    Binding="{Binding FullName}"
                                                                    ElementStyle="{StaticResource GridTextEllipsisStyle}"
                                                                    MinWidth="140"
                                                                    Width="*" />
                                                <DataGridTextColumn Header="新增"
                                                                    Binding="{Binding GrowthDisplay}"
                                                                    ElementStyle="{StaticResource GridNumericTextStyle}"
                                                                    Width="82" />
                                                <DataGridTextColumn Header="当前 Star"
                                                                    Binding="{Binding StarsDisplay}"
                                                                    SortMemberPath="Stars"
                                                                    ElementStyle="{StaticResource GridNumericTextStyle}"
                                                                    Width="98" />
                                                <DataGridTextColumn Header="语言"
                                                                    Binding="{Binding Language}"
                                                                    ElementStyle="{StaticResource GridTextEllipsisStyle}"
                                                                    Width="90" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>

                        <Border Grid.Column="4" Style="{StaticResource PanelCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="14,13,14,10"
                                           Text="仓库详解"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <ScrollViewer Grid.Row="1"
                                              Margin="14,0,14,8"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock x:Name="DetailNameText"
                                                   Text="选择一个仓库查看详情"
                                                   FontFamily="Segoe UI Variable Display"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="DetailDescriptionText"
                                                   Margin="0,8,0,0"
                                                   Text="查询结果会显示在这里。"
                                                   TextWrapping="Wrap"
                                                   LineHeight="21" />
                                        <TextBlock Margin="0,14,0,0"
                                                   Text="功能简介"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="DetailSummaryText"
                                                   Margin="0,4,0,0"
                                                   Text="选择项目后自动读取 README 简介。"
                                                   TextWrapping="Wrap"
                                                   LineHeight="21" />
                                        <TextBlock Margin="0,14,0,0"
                                                   Text="AI 总结与翻译"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="DetailLlmText"
                                                   Margin="0,4,0,0"
                                                   Text="导入本地 LLM 包后自动生成。"
                                                   TextWrapping="Wrap"
                                                   LineHeight="21" />
                                        <TextBlock x:Name="DetailStatsText"
                                                   Margin="0,14,0,0"
                                                   TextWrapping="Wrap"
                                                   LineHeight="22" />
                                        <TextBlock x:Name="DetailTopicsText"
                                                   Margin="0,12,0,0"
                                                   TextWrapping="Wrap"
                                                   LineHeight="21" />
                                        <TextBlock x:Name="DetailDatesText"
                                                   Margin="0,12,0,0"
                                                   TextWrapping="Wrap"
                                                   LineHeight="21"
                                                   Style="{StaticResource QuietTextStyle}" />
                                    </StackPanel>
                                </ScrollViewer>
                                <StackPanel Grid.Row="2" Margin="14,0,14,14">
                                    <TextBlock Margin="0,0,0,6"
                                               Text="收藏到目录"
                                               FontWeight="SemiBold" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="SearchFavoriteFolderComboBox"
                                                  Height="36"
                                                  VerticalAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  Padding="8,0"
                                                  DisplayMemberPath="Name"
                                                  SelectionChanged="SearchFavoriteFolderComboBox_SelectionChanged" />
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Padding="10,6"
                                                Content="新建目录"
                                                Click="CreateFolderFromSearch_Click" />
                                    </Grid>
                                    <Button x:Name="FavoriteRepositoryButton"
                                            Margin="0,8,0,0"
                                            Padding="10,7"
                                            Content="收藏到所选目录"
                                            IsEnabled="False"
                                            Click="FavoriteRepositoryButton_Click" />
                                    <TextBlock x:Name="SearchFavoriteHintText"
                                               Margin="0,6,0,8"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource QuietTextStyle}"
                                               Text="先在搜索结果中选择一个仓库。" />
                                    <Button x:Name="OpenRepositoryButton"
                                            Padding="10,7"
                                            Content="在 GitHub 中打开"
                                            IsEnabled="False"
                                            Click="OpenRepositoryButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="总榜">
                <Grid Margin="0"
                      TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,12" Padding="14" Style="{StaticResource CommandBarStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
