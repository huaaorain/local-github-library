                        <GridSplitter Grid.Column="3"
                                      AutomationProperties.Name="调整右侧仓库详情宽度"
                                      DragCompleted="PanelSplitter_DragCompleted"
                                      Style="{StaticResource PanelSplitterStyle}" />

                        <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="14,13,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="总榜记录"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="GlobalHistoryCountText"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource QuietTextStyle}"
                                               Text="0 份" />
                                </Grid>
                                <ListBox x:Name="GlobalHistoryList"
                                         Grid.Row="1"
                                         Margin="6,0"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="GlobalHistoryList_SelectionChanged"
                                         MouseDoubleClick="GlobalHistoryList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,7">
                                                <TextBlock Text="{Binding Keyword}"
                                                           FontWeight="SemiBold"
                                                           ToolTip="{Binding Keyword}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding DisplayTimestamp}"
                                                           Style="{StaticResource QuietTextStyle}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="1"
                                           Text="暂无总榜记录。&#10;选择周期并点击“统计总榜”。">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource EmptyStateTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=GlobalHistoryList}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button x:Name="OpenGlobalHistoryButton"
                                        Grid.Row="2"
                                        Margin="12"
                                        Padding="10,7"
                                        Content="打开所选总榜报告"
                                        IsEnabled="False"
                                        Click="OpenGlobalHistoryButton_Click" />
