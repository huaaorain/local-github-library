                                <ColumnDefinition x:Name="GlobalPeriodLabelColumn" Width="Auto" />
                                <ColumnDefinition x:Name="GlobalPeriodComboColumn" Width="200" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="榜单类型"
                                       FontWeight="SemiBold" />
                            <ComboBox x:Name="GlobalModeComboBox"
                                      Grid.Column="1"
                                      Height="36"
                                      Margin="10,0,18,0"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Padding="8,0"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="GlobalModeComboBox_SelectionChanged" />
                            <TextBlock x:Name="GlobalPeriodLabelText"
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Text="统计周期"
                                       FontWeight="SemiBold" />
                            <ComboBox x:Name="GlobalPeriodComboBox"
                                      Grid.Column="3"
                                      Height="36"
                                      Margin="10,0,18,0"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Padding="8,0"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="GlobalRankingInput_Changed" />
                            <TextBlock Grid.Column="4"
                                       VerticalAlignment="Center"
                                       Text="显示数量"
                                       FontWeight="SemiBold" />
                            <ComboBox x:Name="GlobalCountComboBox"
                                      Grid.Column="5"
                                      Height="36"
                                      Margin="10,0,18,0"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Padding="8,0"
                                      IsEditable="True"
                                      SelectionChanged="GlobalRankingInput_Changed"
                                      LostKeyboardFocus="GlobalCountComboBox_LostKeyboardFocus"
                                      PreviewKeyDown="GlobalCountComboBox_PreviewKeyDown"
                                      ToolTip="可选择 10、20、50、100，也可以直接输入 1-1000" />
                            <Button x:Name="CollectGlobalButton"
                                    Grid.Column="6"
                                    VerticalAlignment="Center"
                                    Padding="16,7"
                                    Content="统计总榜"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="CollectGlobalButton_Click" />
                            <Button x:Name="SaveGlobalButton"
                                    Grid.Column="7"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Padding="16,7"
                                    Content="保存此排行"
                                    IsEnabled="False"
                                    Click="SaveGlobalButton_Click" />
