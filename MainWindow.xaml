<Window x:Class="GitHubTopicReports.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:GitHubTopicReports.Models"
        mc:Ignorable="d"
        Title="Local GitHub Library"
        Icon="Resources/app.ico"
        Height="800"
        Width="1240"
        MinHeight="620"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        SizeChanged="MainWindow_SizeChanged">
    <AdornerDecorator>
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,16,20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="250" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Local GitHub Library"
                               Style="{StaticResource AppTitleStyle}" />
                    <TextBlock x:Name="HeaderDescriptionText"
                               Margin="0,4,0,0"
                               MaxWidth="520"
                               HorizontalAlignment="Left"
                               Text="搜索公开与私有仓库，保存报告、整理收藏，并记录本地 Markdown 笔记。"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="搜索公开与私有仓库，保存报告、整理收藏，并记录本地 Markdown 笔记。"
                               Style="{StaticResource QuietTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right">
                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="ThemeToggleButton"
                                Content="深色模式"
                                AutomationProperties.Name="切换深色或浅色主题"
                                ToolTip="切换深色或浅色主题"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Click="ThemeToggleButton_Click" />
                        <Button x:Name="SettingsButton"
                                Width="34"
                                Margin="8,0,0,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="软件设置"
                                ToolTip="软件设置"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Click="SettingsButton_Click">
                            <TextBlock Text="⚙"
                                       FontSize="17"
                                       VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                    <StackPanel Margin="0,5,2,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <TextBlock x:Name="VersionText"
                                   Style="{StaticResource QuietTextStyle}" />
                        <TextBlock Margin="10,0,0,0"
                                   Text="·"
                                   Style="{StaticResource QuietTextStyle}" />
                        <TextBlock x:Name="LlmStatusText"
                                   Margin="10,0,0,0"
                                   Style="{StaticResource QuietTextStyle}"
                                   Text="本地 LLM：未安装" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,0,20,12">
        <TabControl x:Name="WorkspaceTabs"
                    Margin="12,0,12,0"
                    SelectionChanged="WorkspaceTabs_SelectionChanged">
            <TabItem x:Name="CombinedFavoritesTab" Header="收藏">
                <Grid Margin="0"
                      TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,12" Padding="14" Style="{StaticResource CommandBarStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="搜索关键词"
                                       FontWeight="SemiBold" />
                            <TextBox x:Name="StandaloneSearchKeywordTextBox"
                                     Grid.Column="1"
                                     MinHeight="38"
                                     Margin="10,0,18,0"
                                     Padding="10,7"
                                     VerticalContentAlignment="Center"
                                     FontSize="15"
                                     PreviewKeyDown="StandaloneSearchKeywordTextBox_PreviewKeyDown" />
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Text="数量"
                                       FontWeight="SemiBold" />
                            <ComboBox x:Name="StandaloneSearchCountComboBox"
                                      Grid.Column="3"
                                      Height="36"
                                      Margin="10,0,18,0"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Padding="8,0"
                                      IsEditable="True"
                                      ToolTip="可选择 10、20、50、100，也可以直接输入 1-1000" />
                            <Button x:Name="StandaloneSearchButton"
                                    Grid.Column="4"
                                    Padding="16,7"
                                    Content="搜索 GitHub"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="StandaloneSearchButton_Click" />
                            <Button x:Name="StandaloneSearchCancelButton"
                                    Grid.Column="5"
                                    Margin="8,0,0,0"
                                    Padding="14,7"
                                    Content="取消"
                                    IsEnabled="False"
                                    Click="StandaloneSearchCancelButton_Click" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="CombinedLeftColumn"
                                              Width="220"
                                              MinWidth="190" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition x:Name="CombinedCenterColumn"
                                              Width="*"
                                              MinWidth="320" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition x:Name="CombinedRightColumn"
                                              Width="280"
                                              MinWidth="220" />
                        </Grid.ColumnDefinitions>
                        <GridSplitter Grid.Column="1"
                                      AutomationProperties.Name="调整左侧收藏目录宽度"
                                      DragCompleted="PanelSplitter_DragCompleted"
                                      Style="{StaticResource PanelSplitterStyle}" />
                        <GridSplitter Grid.Column="3"
                                      AutomationProperties.Name="调整右侧仓库详情宽度"
                                      DragCompleted="PanelSplitter_DragCompleted"
                                      Style="{StaticResource PanelSplitterStyle}" />

                        <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="14,13,14,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="收藏目录"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="SearchDirectoryCountText"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource QuietTextStyle}"
                                               Text="0 个" />
                                    <Button x:Name="CreateSearchDirectoryButton"
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            AutomationProperties.Name="新建收藏目录"
                                            ToolTip="新建收藏目录"
                                            Style="{StaticResource CompactIconButtonStyle}"
                                            Click="CreateSearchDirectoryButton_Click">
                                        <Path Width="12"
                                              Height="12"
                                              Data="M 1,6 H 11 M 6,1 V 11"
                                              Stroke="{DynamicResource TextSecondaryBrush}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Button>
                                </Grid>
                                <ListBox x:Name="SearchDirectoryList"
                                         Grid.Row="1"
                                         Margin="6,0"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="SearchDirectoryList_SelectionChanged"
                                         PreviewMouseLeftButtonDown="FavoriteFolderList_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="FavoriteFolderList_PreviewMouseMove"
                                         PreviewMouseLeftButtonUp="FavoriteFolderList_PreviewMouseLeftButtonUp">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding CountDisplay}"
                                                           Style="{StaticResource QuietTextStyle}" />
                                                <Button Grid.Column="2"
                                                        Width="24"
                                                        Height="24"
                                                        Margin="6,0,0,0"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="重命名此目录"
                                                        ToolTip="重命名此目录"
                                                        Style="{StaticResource BorderlessIconButtonStyle}"
                                                        Click="RenameSearchDirectoryButton_Click">
                                                    <Path Width="14"
                                                          Height="14"
                                                          Stretch="Uniform"
                                                          Data="M 2,12 L 2.8,9.2 L 10.5,1.5 C 10.8,1.2 11.2,1.2 11.5,1.5 L 12.5,2.5 C 12.8,2.8 12.8,3.2 12.5,3.5 L 4.8,11.2 Z M 9.8,2.2 L 11.8,4.2"
                                                          Fill="Transparent"
                                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                                          StrokeThickness="1.1"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Button>
                                                <Button Grid.Column="3"
                                                        Width="24"
                                                        Height="24"
                                                        Margin="4,0,0,0"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="删除此目录"
                                                        ToolTip="删除此目录"
                                                        Style="{StaticResource DangerBorderlessIconButtonStyle}"
                                                        Click="DeleteSearchDirectoryButton_Click">
                                                    <Path Width="15"
                                                          Height="15"
                                                          Stretch="Uniform"
                                                          Data="M 2,4.5 H 14 L 13,15 H 3 Z M 5.5,4.5 L 6,1.5 H 10 L 10.5,4.5 Z"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="1"
                                           Text="暂无收藏目录。&#10;点击右上角“+”开始整理项目。">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource EmptyStateTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=SearchDirectoryList}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button x:Name="OpenSearchDirectoryButton"
                                        Grid.Row="2"
                                        Margin="12"
                                        Padding="10,7"
                                        Content="打开所选目录"
                                        IsEnabled="False"
                                        Visibility="Collapsed"
                                        Click="OpenSearchDirectoryButton_Click" />
                                <Button x:Name="ExportFavoriteNotesButton"
                                        Grid.Row="2"
                                        Margin="12,0,12,12"
                                        Padding="10,7"
                                        Content="导出备注"
                                        AutomationProperties.Name="导出全部收藏备注"
                                        ToolTip="将所有目录中的非空备注导出为 TXT 文件"
                                        Click="ExportFavoriteNotesButton_Click" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock x:Name="StandaloneSearchTitleText"
                                           Text="搜索 GitHub 项目"
                                           Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="StandaloneSearchSummaryText"
                                           Margin="0,3,0,0"
                                           Text="搜索 GitHub 后，可选择一条或多条结果收藏到左侧目录。"
                                           Style="{StaticResource QuietTextStyle}" />
                            </StackPanel>
                            <TabControl x:Name="CombinedContentTabs"
                                        Grid.Row="1"
                                        BorderThickness="1"
                                        SelectionChanged="CombinedContentTabs_SelectionChanged">
                                <TabItem x:Name="CombinedSearchResultsTab"
                                         Header="搜索结果">
                            <DataGrid x:Name="StandaloneSearchResultsGrid"
                                      AutoGenerateColumns="False"
                                      BorderThickness="1"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      SelectionMode="Extended"
                                      SelectionChanged="StandaloneSearchResultsGrid_SelectionChanged"
                                      Sorting="SearchResultsGrid_Sorting"
                                      MouseDoubleClick="StandaloneSearchResultsGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#"
                                                        Binding="{Binding Rank}"
                                                        SortMemberPath="Rank"
                                                        ElementStyle="{StaticResource GridNumericTextStyle}"
                                                        Width="42" />
                                    <DataGridTextColumn Header="仓库"
                                                        Binding="{Binding FullName}"
                                                        SortMemberPath="FullName"
                                                        ElementStyle="{StaticResource GridTextEllipsisStyle}"
                                                        MinWidth="140"
                                                        Width="*" />
                                    <DataGridTextColumn Header="Star"
                                                        Binding="{Binding StarsDisplay}"
                                                        SortMemberPath="Stars"
                                                        ElementStyle="{StaticResource GridNumericTextStyle}"
                                                        Width="90" />
                                    <DataGridTextColumn Header="语言"
                                                        Binding="{Binding Language}"
                                                        ElementStyle="{StaticResource GridTextEllipsisStyle}"
                                                        Width="95" />
                                    <DataGridTextColumn Header="更新"
                                                        Binding="{Binding UpdatedDisplay}"
                                                        ElementStyle="{StaticResource GridTextEllipsisStyle}"
                                                        Width="95" />
                                </DataGrid.Columns>
                            </DataGrid>
                                </TabItem>
                                <TabItem x:Name="CombinedDirectoryTab"
                                         Header="目录内容">
                                    <DataGrid x:Name="CombinedFavoritesGrid"
                                              AutoGenerateColumns="False"
                                              BorderThickness="1"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserReorderColumns="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              SelectionMode="Single"
                                              CanUserSortColumns="False"
                                              PreviewMouseLeftButtonDown="CombinedFavoritesGrid_PreviewMouseLeftButtonDown"
                                              PreviewMouseMove="CombinedFavoritesGrid_PreviewMouseMove"
                                              PreviewMouseLeftButtonUp="CombinedFavoritesGrid_PreviewMouseLeftButtonUp"
                                              SelectionChanged="CombinedFavoritesGrid_SelectionChanged"
                                              MouseDoubleClick="CombinedFavoritesGrid_MouseDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="仓库"
                                                                    SortMemberPath="FullName"
                                                                    MinWidth="140"
                                                                    Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button Width="24"
                                                                    Height="24"
                                                                    Padding="0"
                                                                    VerticalAlignment="Center"
                                                                    AutomationProperties.Name="查看收藏备注"
                                                                    ToolTip="{Binding Note}"
                                                                    Click="CombinedFavoriteNoteButton_Click">
                                                                <Button.Style>
                                                                    <Style TargetType="Button"
                                                                           BasedOn="{StaticResource BorderlessIconButtonStyle}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasNote}"
                                                                                         Value="False">
                                                                                <Setter Property="Visibility"
                                                                                        Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <Grid Width="14"
                                                                      Height="14">
                                                                    <Border Width="12"
                                                                            Height="10"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                                                            BorderThickness="1.1"
                                                                            CornerRadius="2" />
                                                                    <Path Data="M 4,5 H 10 M 4,7.5 H 10 M 4,10 H 8"
                                                                          Stroke="{DynamicResource PrimaryBrush}"
                                                                          StrokeThickness="1"
                                                                          StrokeStartLineCap="Round"
                                                                          StrokeEndLineCap="Round" />
                                                                </Grid>
                                                            </Button>
                                                            <TextBlock Grid.Column="1"
                                                                       Margin="4,0,0,0"
                                                                       Text="{Binding FullName}"
                                                                       Tag="FavoriteRepositoryName"
                                                                       Style="{StaticResource GridTextEllipsisStyle}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Star"
                                                                Binding="{Binding StarsDisplay}"
                                                                SortMemberPath="Stars"
                                                                ElementStyle="{StaticResource GridNumericTextStyle}"
                                                                Width="90" />
                                            <DataGridTextColumn Header="语言"
                                                                Binding="{Binding Language}"
                                                                ElementStyle="{StaticResource GridTextEllipsisStyle}"
                                                                Width="95" />
                                            <DataGridTextColumn Header="收藏时间"
                                                                Binding="{Binding SavedAtDisplay}"
                                                                ElementStyle="{StaticResource GridTextEllipsisStyle}"
                                                                Width="125" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                            </TabControl>
                        </Grid>

                        <Border Grid.Column="4" Style="{StaticResource PanelCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="14,9,14,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Text="仓库详解"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <Button x:Name="FavoriteNoteButton"
                                            Grid.Column="1"
                                            MinHeight="30"
                                            Padding="9,4"
                                            FontSize="12"
                                            Content="添加备注"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="添加或查看收藏备注"
                                            Click="FavoriteNoteButton_Click" />
                                </Grid>
                                <ScrollViewer Grid.Row="1"
                                              Margin="14,0,14,8"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock x:Name="StandaloneDetailNameText"
                                                   Text="选择一个仓库查看详情"
                                                   FontFamily="Segoe UI Variable Display"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="StandaloneDetailDescriptionText"
                                                   Margin="0,8,0,0"
                                                   Text="搜索结果会显示在这里。"
                                                   TextWrapping="Wrap"
                                                   LineHeight="21" />
                                        <TextBlock Margin="0,14,0,0"
                                                   Text="功能简介"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="StandaloneDetailSummaryText"
                                                   Margin="0,4,0,0"
                                                   Text="选择项目后自动读取 README 简介。"
                                                   TextWrapping="Wrap"
                                                   LineHeight="21" />
                                        <TextBlock Margin="0,14,0,0"
                                                   Text="AI 总结与翻译"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="StandaloneDetailLlmText"
                                                   Margin="0,4,0,0"
                                                   Text="导入本地 LLM 包后自动生成。"
                                                   TextWrapping="Wrap"
                                                   LineHeight="21" />
                                        <TextBlock x:Name="StandaloneDetailStatsText"
                                                   Margin="0,14,0,0"
                                                   TextWrapping="Wrap"
                                                   LineHeight="22" />
                                        <TextBlock x:Name="StandaloneDetailTopicsText"
                                                   Margin="0,12,0,0"
                                                   TextWrapping="Wrap"
                                                   LineHeight="21" />
                                        <StackPanel x:Name="StandaloneNoteSection"
                                                    Margin="0,14,0,0"
                                                    Visibility="Collapsed">
                                            <TextBlock Text="我的备注"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="StandaloneDetailNoteText"
                                                       Margin="0,4,0,0"
                                                       Text="尚未添加备注。"
                                                       TextWrapping="Wrap"
                                                       LineHeight="21" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                                <StackPanel Grid.Row="2" Margin="14,0,14,14">
                                    <TextBlock Margin="0,0,0,6"
                                               Text="收藏到目录"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="SearchSaveFolderText"
                                               Margin="0,0,0,8"
                                               Text="请先选择一个搜索目录。"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource QuietTextStyle}" />
                                    <Button x:Name="FavoriteSelectedSearchResultsButton"
                                            Padding="10,7"
                                            Content="收藏所选结果"
                                            IsEnabled="False"
                                            Click="FavoriteSelectedSearchResultsButton_Click" />
                                    <Button x:Name="SaveSearchResultsButton"
                                            Margin="0,8,0,0"
                                            Padding="10,7"
                                            Content="收藏全部搜索结果"
                                            IsEnabled="False"
                                            Click="SaveSearchResultsButton_Click" />
                                    <Button x:Name="OpenStandaloneRepositoryButton"
                                            Margin="0,8,0,0"
                                            Padding="10,7"
                                            Content="在 GitHub 中打开"
                                            IsEnabled="False"
                                            Click="OpenStandaloneRepositoryButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="查找">
                <Grid Margin="0"
                      TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,12" Padding="14" Style="{StaticResource CommandBarStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Text="搜索主题"
                                       FontWeight="SemiBold" />
                            <TextBox x:Name="KeywordTextBox"
                                     Grid.Column="1"
                                     MinHeight="38"
                                     Padding="10,7"
                                     VerticalContentAlignment="Center"
                                     FontSize="15"
                                     ToolTip="例如：machine learning、game engine、database"
                                     PreviewKeyDown="KeywordTextBox_PreviewKeyDown" />
                            <Button x:Name="SearchButton"
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    Content="开始查找"
                                    IsDefault="True"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="SearchButton_Click" />
                            <Button x:Name="CancelButton"
                                    Grid.Column="3"
                                    Margin="8,0,0,0"
                                    Content="取消"
                                    IsEnabled="False"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="CancelButton_Click" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FindLeftColumn"
                                              Width="220"
                                              MinWidth="190" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition x:Name="FindCenterColumn"
                                              Width="*"
                                              MinWidth="320" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition x:Name="FindRightColumn"
                                              Width="310"
                                              MinWidth="220" />
