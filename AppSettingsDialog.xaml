<Window x:Class="GitHubTopicReports.AppSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="软件设置"
        Icon="Resources/app.ico"
        Width="600"
        Height="740"
        MinWidth="540"
        MinHeight="690"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI Variable Text"
        FontSize="14"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="软件设置"
                       FontFamily="Segoe UI Variable Display"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0"
                       Text="集中管理常用工具和窗口关闭行为。"
                       Style="{StaticResource QuietTextStyle}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,12"
                Padding="16,14"
                Style="{StaticResource PanelCardStyle}">
            <StackPanel>
                <TextBlock Text="快捷操作"
                           Style="{StaticResource SectionTitleStyle}" />
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ImportLlmActionButton"
                            Margin="0,0,6,6"
                            MinHeight="42"
                            Padding="14,8"
                            HorizontalContentAlignment="Left"
                            Content="导入 LLM"
                            Tag="ImportLlm"
                            Click="ActionButton_Click" />
                    <Button x:Name="ImportConfigurationActionButton"
                            Grid.Column="1"
                            Margin="6,0,0,6"
                            MinHeight="42"
                            Padding="14,8"
                            HorizontalContentAlignment="Left"
                            Content="导入配置"
                            Tag="ImportConfiguration"
                            Click="ActionButton_Click" />
                    <Button x:Name="ExportConfigurationActionButton"
                            Grid.Row="1"
                            Margin="0,6,6,0"
                            MinHeight="42"
                            Padding="14,8"
                            HorizontalContentAlignment="Left"
                            Content="导出配置"
                            Tag="ExportConfiguration"
                            Click="ActionButton_Click" />
                    <Button x:Name="OpenLibraryActionButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="6,6,0,0"
                            MinHeight="42"
                            Padding="14,8"
                            HorizontalContentAlignment="Left"
                            Content="打开文档库"
                            Tag="OpenLibrary"
                            Click="ActionButton_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,12"
                Padding="16,14"
                Style="{StaticResource PanelCardStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="GitHub 账号"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="GitHubAccountStatusText"
                                   Margin="0,7,0,0"
                                   FontWeight="SemiBold"
                                   Text="正在检查登录状态..." />
                        <TextBlock x:Name="GitHubAccountHintText"
                                   Margin="0,3,0,0"
                                   MaxWidth="410"
                                   Text="登录后可搜索账号有权限访问的私有仓库。"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource QuietTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button x:Name="GitHubLoginButton"
                                Padding="14,8"
                                Content="登录"
                                Click="GitHubLoginButton_Click" />
                        <Button x:Name="GitHubLogoutButton"
                                Padding="14,8"
                                Content="退出登录"
                                Visibility="Collapsed"
                                Click="GitHubLogoutButton_Click" />
                    </StackPanel>
                </Grid>

                <Border x:Name="GitHubLoginPanel"
                        Margin="0,12,0,0"
                        Padding="12"
                        Background="{DynamicResource SurfaceSubtleBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Personal Access Token"
                                   FontWeight="SemiBold" />
                        <PasswordBox x:Name="GitHubTokenPasswordBox"
                                     MinHeight="36"
                                     Margin="0,8,0,0"
                                     Padding="9,6"
                                     VerticalContentAlignment="Center" />
                        <TextBlock Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource QuietTextStyle}">
                            <Run Text="建议创建 Fine-grained token，并为需要查询的私有仓库授予 " />
                            <Run Text="Metadata" FontWeight="SemiBold" />
                            <Run Text=" 与 " />
                            <Run Text="Contents" FontWeight="SemiBold" />
                            <Run Text=" 的只读权限。" />
                            <Hyperlink NavigateUri="https://github.com/settings/tokens?type=beta"
                                       RequestNavigate="CreateGitHubTokenLink_RequestNavigate">
                                打开 Token 设置
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0"
                                   Text="Token 仅加密保存在本机当前 Windows 用户下，不会写入报告或配置导出文件。"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource QuietTextStyle}" />
                        <TextBlock x:Name="GitHubLoginErrorText"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <StackPanel Margin="0,10,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Padding="12,7"
                                    Content="取消"
                                    Click="CancelGitHubLoginButton_Click" />
                            <Button x:Name="ConfirmGitHubLoginButton"
                                    Margin="8,0,0,0"
                                    Padding="14,7"
                                    Content="验证并登录"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ConfirmGitHubLoginButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Padding="16,14"
                Style="{StaticResource PanelCardStyle}">
            <StackPanel>
                <TextBlock Text="关闭窗口时"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Margin="0,5,0,0"
                           Text="取消勾选“每次关闭窗口时询问我”后，将直接执行这里的选项。"
                           TextWrapping="Wrap"
                           Style="{StaticResource QuietTextStyle}" />
                <RadioButton x:Name="MinimizeToTrayRadio"
                             GroupName="CloseAction"
                             Margin="0,14,0,0"
                             Content="最小化到右下角系统托盘" />
                <RadioButton x:Name="ExitRadio"
                             GroupName="CloseAction"
                             Margin="0,8,0,0"
                             Content="完全退出程序" />
                <CheckBox x:Name="AskOnCloseCheckBox"
                          Margin="0,14,0,0"
                          Content="每次关闭窗口时询问我" />
                <CheckBox x:Name="StartWithWindowsCheckBox"
                          Margin="0,8,0,0"
                          Content="开机时自动启动 Local GitHub Library" />
                <TextBlock Margin="0,14,0,0"
                           Text="最小化后呼出窗口"
                           FontWeight="SemiBold" />
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RestoreHotkeyTextBox"
                             MinHeight="36"
                             Padding="9,6"
                             IsReadOnly="True"
                             Cursor="Hand"
                             ToolTip="点击后按下新的组合键，例如 Ctrl+Shift+D"
                             PreviewKeyDown="RestoreHotkeyTextBox_PreviewKeyDown" />
                    <Button x:Name="ResetHotkeyButton"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="12,7"
                            Content="恢复默认"
                            Click="ResetHotkeyButton_Click" />
                </Grid>
                <TextBlock x:Name="HotkeyHintText"
                           Margin="0,5,0,0"
                           Text="点击输入框后按下组合键。需要至少包含 Ctrl、Alt、Shift 或 Win 中的一个修饰键。"
                           TextWrapping="Wrap"
                           Style="{StaticResource QuietTextStyle}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Margin="0,12,0,0"
                Padding="14,12"
                Background="{DynamicResource SurfaceSubtleBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <TextBlock Text="设置会保存在本地，并随 .ghconfig 配置包一起导出。"
                       TextWrapping="Wrap"
                       Style="{StaticResource QuietTextStyle}" />
        </Border>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="88"
                        Padding="10,7"
                        Content="取消"
                        IsCancel="True" />
                <Button x:Name="SaveSettingsButton"
                        Width="96"
                        Margin="8,0,0,0"
                        Padding="10,7"
                        Content="保存"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SaveSettingsButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
