<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F7FB" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EAF0F7" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#142033" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#506176" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#CCD6E3" />
    <SolidColorBrush x:Key="DividerBrush" Color="#DCE4EE" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1F5FBF" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#184E9F" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#143F82" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#E8F0FF" />
    <SolidColorBrush x:Key="FocusBrush" Color="#0B6FD8" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7A58" />
    <SolidColorBrush x:Key="WarningBrush" Color="#8A5200" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
    <SolidColorBrush x:Key="DangerIconBrush" Color="#D68B8B" />
    <SolidColorBrush x:Key="DangerIconHoverBrush" Color="#C96F6F" />
    <SolidColorBrush x:Key="DangerIconPressedBrush" Color="#E1192D" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#66142033" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#F4F7FB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#142033" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#EAF0F7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#142033" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#CCD6E3" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E8F0FF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#142033" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ScrollBarBrushKey}" Color="#EAF0F7" />
</ResourceDictionary>
