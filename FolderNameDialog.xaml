<Window x:Class="GitHubTopicReports.FolderNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="收藏目录"
        Width="430"
        MinHeight="220"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text"
        FontSize="14"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Grid Margin="20,20,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText"
                   FontFamily="Segoe UI Variable Display"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Text="新建收藏目录" />
        <TextBlock x:Name="PromptText"
                   Grid.Row="1"
                   Margin="0,5,0,12"
                   Text="输入目录名称"
                   Style="{StaticResource QuietTextStyle}" />
        <TextBox x:Name="FolderNameTextBox"
                 Grid.Row="2"
                 MinHeight="38"
                 Padding="10,7"
                 VerticalContentAlignment="Center"
                 MaxLength="40"
                 KeyDown="FolderNameTextBox_KeyDown" />
        <StackPanel Grid.Row="3"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="88"
                    Padding="10,7"
                    Content="取消"
                    IsCancel="True" />
            <Button Width="88"
                    Margin="8,0,0,0"
                    Padding="10,7"
                    Content="确定"
                    IsDefault="True"
                    Click="OkButton_Click" />
        </StackPanel>
    </Grid>
</Window>
