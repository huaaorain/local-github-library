<Window x:Class="GitHubTopicReports.CloseBehaviorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭 Local GitHub Library"
        Width="440"
        Height="420"
        MinWidth="400"
        MinHeight="400"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text"
        FontSize="14"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="关闭 Local GitHub Library？"
                   FontFamily="Segoe UI Variable Display"
                   FontSize="21"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Margin="0,6,0,0"
                   Text="请选择关闭窗口后的操作。"
                   Style="{StaticResource QuietTextStyle}" />

        <StackPanel Grid.Row="2"
                    Margin="0,18,0,0">
            <Button Padding="14,10"
                    HorizontalContentAlignment="Left"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="MinimizeButton_Click">
                <StackPanel>
                    <TextBlock Text="最小化到系统托盘"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,2,0,0"
                               Text="程序继续在右下角运行"
                               FontSize="12"
                               Opacity="0.8" />
                </StackPanel>
            </Button>
            <Button Margin="0,8,0,0"
                    Padding="14,10"
                    HorizontalContentAlignment="Left"
                    Foreground="{DynamicResource DangerBrush}"
                    Click="ExitButton_Click">
                <StackPanel>
                    <TextBlock Text="完全退出程序"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,2,0,0"
                               Text="结束程序并关闭托盘图标"
                               FontSize="12"
                               Opacity="0.8" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="3">
            <CheckBox x:Name="AskAgainCheckBox"
                      Margin="0,18,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Content="每次关闭窗口时都询问我" />
            <Button Width="88"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Padding="10,7"
                    Content="取消"
                    IsCancel="True" />
        </Grid>
    </Grid>
</Window>
