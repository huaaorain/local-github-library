<Window x:Class="GitHubTopicReports.FavoriteNoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="收藏备注"
        Icon="Resources/app.ico"
        Width="620"
        Height="500"
        MinWidth="520"
        MinHeight="420"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI Variable Text"
        FontSize="14"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="收藏备注"
                       FontFamily="Segoe UI Variable Display"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="RepositoryText"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap"
                       Style="{StaticResource QuietTextStyle}" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Margin="0,16,0,7"
                   Text="记录用途、后续计划或需要提醒自己的内容"
                   FontWeight="SemiBold" />

        <TextBox x:Name="NoteTextBox"
                 Grid.Row="2"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 MaxLength="4000"
                 HorizontalScrollBarVisibility="Disabled"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 AutomationProperties.Name="收藏备注内容"
                 TextChanged="NoteTextBox_TextChanged" />

        <Grid Grid.Row="3" Margin="0,7,0,0">
            <TextBlock Text="备注仅保存在本机收藏数据中，并可随 .ghconfig 导出。"
                       Style="{StaticResource QuietTextStyle}" />
            <TextBlock x:Name="NoteCountText"
                       HorizontalAlignment="Right"
                       Style="{StaticResource QuietTextStyle}"
                       Text="0 / 4000" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Button x:Name="DeleteNoteButton"
                    Width="104"
                    HorizontalAlignment="Left"
                    Padding="10,7"
                    Foreground="{DynamicResource DangerBrush}"
                    Content="删除备注"
                    Visibility="Collapsed"
                    Click="DeleteNoteButton_Click" />
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="88"
                        Padding="10,7"
                        Content="取消"
                        IsCancel="True" />
                <Button x:Name="SaveNoteButton"
                        Width="104"
                        Margin="8,0,0,0"
                        Padding="10,7"
                        Content="保存备注"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SaveNoteButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
