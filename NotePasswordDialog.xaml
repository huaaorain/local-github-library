<Window x:Class="GitHubTopicReports.NotePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="加密笔记"
        Icon="Resources/app.ico"
        Width="430"
        Height="300"
        MinWidth="390"
        MinHeight="270"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text"
        FontSize="14"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="DialogTitleText"
                   FontFamily="Segoe UI Variable Display"
                   FontSize="22"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="PromptText"
                   Grid.Row="1"
                   Margin="0,6,0,14"
                   TextWrapping="Wrap"
                   Style="{StaticResource QuietTextStyle}" />
        <StackPanel Grid.Row="2">
            <TextBlock Text="密码" FontWeight="SemiBold" />
            <Grid Margin="0,7,0,0">
                <PasswordBox x:Name="PasswordInput"
                             MinHeight="36"
                             Padding="34,6,9,6"
                             VerticalContentAlignment="Center" />
                <Path Width="14"
                      Height="14"
                      Margin="11,0,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      Stretch="Uniform"
                      Data="M 2,6 H 12 V 16 H 2 Z M 4,6 V 4 C 4,0.8 10,0.8 10,4 V 6">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="StrokeThickness" Value="1.3" />
                            <Setter Property="StrokeStartLineCap" Value="Round" />
                            <Setter Property="StrokeEndLineCap" Value="Round" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=PasswordInput}"
                                             Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                    <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>
            <StackPanel x:Name="ConfirmationPanel" Margin="0,10,0,0">
                <TextBlock Text="确认密码" FontWeight="SemiBold" />
                <PasswordBox x:Name="ConfirmationInput"
                             MinHeight="36"
                             Margin="0,7,0,0"
                             Padding="9,6"
                             VerticalContentAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="ErrorText"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>
        <StackPanel Grid.Row="4"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="88"
                    Content="取消"
                    IsCancel="True" />
            <Button x:Name="ConfirmButton"
                    Width="104"
                    Margin="8,0,0,0"
                    Content="解锁"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="ConfirmButton_Click" />
        </StackPanel>
    </Grid>
</Window>
